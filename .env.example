# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Do NOT commit the actual .env file to version control.
# Copy this file to .env and fill in the real values.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string. 
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/pigproject"

# ------------------------------------------------------------------------------
# AUTHENTICATION (NEXTAUTH)
# ------------------------------------------------------------------------------
# Secret used to encrypt session cookies. 
# Generate a random 32-character string (e.g. using `openssl rand -base64 32`)
NEXTAUTH_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING"

# The canonical URL of your site. 
# In local development: http://localhost:3000
# In production: https://your-production-domain.com
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# PUBLIC APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# The public URL of the application, used for absolute links in emails/sharing
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SECURITY & OTP
# ------------------------------------------------------------------------------
# Secret key used for generating and verifying One-Time Passwords
OTP_SECRET="CHANGE_ME_OTP_SECRET"

# ------------------------------------------------------------------------------
# FILE STORAGE (e.g., AWS S3 / Supabase / Cloudinary)
# ------------------------------------------------------------------------------
# Credentials for secure object storage for Beneficiary photos and Veterinary documents
STORAGE_ACCESS_KEY="CHANGE_ME_ACCESS_KEY"
STORAGE_SECRET_KEY="CHANGE_ME_SECRET_KEY"
STORAGE_BUCKET_NAME="pig-project-uploads"
STORAGE_REGION="us-east-1"

# ------------------------------------------------------------------------------
# EMAIL / SMTP (For Notifications)
# ------------------------------------------------------------------------------
EMAIL_SERVER="smtp://username:password@smtp.example.com:587"
EMAIL_FROM="noreply@valueprotocols.rw"
